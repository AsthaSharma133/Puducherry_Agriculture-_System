# Copy to .env (git-ignored). Every key is optional: the pipeline runs without any of them.

# LangSmith tracing (optional). Leave LANGSMITH_API_KEY empty to disable tracing.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=team35-puducherry-agri
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# data.gov.in OGD API key for S1 (AGMARKNET daily prices) - S1 is Pending in Phase 3.
DATA_GOV_IN_API_KEY=
