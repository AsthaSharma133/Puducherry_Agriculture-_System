# Copy to .env (git-ignored) and fill in only what you use. Every variable is optional:
# with all of them empty the whole project runs offline exactly as documented.
# Never commit real keys.

# LangSmith tracing of agent runs and the optional eval upload
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=

# Optional LLM fallback in app/query_engine.py (only when keyword rules cannot parse a question)
ANTHROPIC_API_KEY=

# data.gov.in OGD key for S1 AGMARKNET daily prices (S1 is Pending in Phase 3)
DATA_GOV_IN_API_KEY=
